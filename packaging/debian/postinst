#!/bin/sh
set -e

# All install/config logic lives in gnss2tec-reconfigure so there is a single
# source of truth shared with the operator-run command. It is unpacked before
# this runs and executes as root here, so its sudo self-elevation is a no-op.
case "$1" in
    configure)
        if [ -x /usr/bin/gnss2tec-reconfigure ]; then
            /usr/bin/gnss2tec-reconfigure || true
        fi
        ;;
esac

exit 0
