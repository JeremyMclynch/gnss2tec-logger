#!/bin/sh
set -e

# Keep GNSS data in /var/lib so it survives package removal.
install -d -m 0750 -o root -g root /var/lib/gnss2tec-logger
install -d -m 0750 -o root -g root /var/lib/gnss2tec-logger/data
install -d -m 0750 -o root -g root /var/lib/gnss2tec-logger/archive
install -d -m 0750 -o root -g root /var/lib/gnss2tec-logger/backup

# Install or remove ArduSimple udev rule based on runtime.env toggle.
UDEV_RULE_SRC="/usr/share/gnss2tec-logger/udev/99-gnss2tec-logger.rules"
UDEV_RULE_DST="/etc/udev/rules.d/99-gnss2tec-logger.rules"
GNSS2TEC_UDEV_ARDUSIMPLE="false"
if [ -f /etc/gnss2tec-logger/runtime.env ]; then
    . /etc/gnss2tec-logger/runtime.env 2>/dev/null || true
fi
if [ "$GNSS2TEC_UDEV_ARDUSIMPLE" = "true" ] && [ -f "$UDEV_RULE_SRC" ]; then
    install -m 0644 "$UDEV_RULE_SRC" "$UDEV_RULE_DST"
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger || true
    fi
elif [ -f "$UDEV_RULE_DST" ]; then
    rm -f "$UDEV_RULE_DST"
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
    fi
fi

# Enable and start the service when systemd is available.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable gnss2tec-logger.service || true
    systemctl restart gnss2tec-logger.service || true

    # Enable or disable USB CDC ACM gadget console based on runtime.env toggle.
    MODULES_LOAD_CONF="/etc/modules-load.d/gnss2tec-usb-gadget.conf"
    if [ "$GNSS2TEC_USB_GADGET_CONSOLE" = "true" ]; then
        # Ensure libcomposite loads at boot so the gadget configfs tree exists.
        echo "libcomposite" > "$MODULES_LOAD_CONF"
        modprobe libcomposite 2>/dev/null || true

        systemctl enable gnss2tec-usb-gadget.service || true
        systemctl enable gnss2tec-usb-getty.service || true
        systemctl start gnss2tec-usb-gadget.service || true
        systemctl start gnss2tec-usb-getty.service || true
    else
        rm -f "$MODULES_LOAD_CONF"
        systemctl stop gnss2tec-usb-getty.service 2>/dev/null || true
        systemctl stop gnss2tec-usb-gadget.service 2>/dev/null || true
        systemctl disable gnss2tec-usb-getty.service 2>/dev/null || true
        systemctl disable gnss2tec-usb-gadget.service 2>/dev/null || true
    fi

    # Enable or disable GPS time sync (chrony NTP SHM refclock) based on toggle.
    # The logger writes GPS time to SHM unit 0; chrony reads it via refclock SHM 0.
    CHRONY_CONF_DIR="/etc/chrony/conf.d"
    CHRONY_CONF="${CHRONY_CONF_DIR}/gnss2tec-gps.conf"
    if [ "$GNSS2TEC_GPS_TIME_SYNC" = "true" ]; then
        if command -v chronyd >/dev/null 2>&1; then
            if [ -d "$CHRONY_CONF_DIR" ]; then
                cat > "$CHRONY_CONF" <<'CHRONYEOF'
# Managed by gnss2tec-logger (GNSS2TEC_GPS_TIME_SYNC). Do not edit by hand.
# GPS time delivered by the logger through the NTP shared-memory refclock.
refclock SHM 0 refid GPS precision 1e-2 offset 0.0
# Allow stepping a wildly-wrong RTC at any time (offline boots have no NTP).
makestep 1 -1
CHRONYEOF
                systemctl enable chrony.service 2>/dev/null || systemctl enable chronyd.service 2>/dev/null || true
                systemctl restart chrony.service 2>/dev/null || systemctl restart chronyd.service 2>/dev/null || true
            else
                echo "gnss2tec-logger: $CHRONY_CONF_DIR not found; your chrony build may not include 'confdir'." >&2
                echo "gnss2tec-logger: add 'refclock SHM 0 refid GPS' and 'makestep 1 -1' to chrony.conf manually." >&2
            fi
        else
            echo "gnss2tec-logger: GPS time sync requested but chrony is not installed; install it then re-run dpkg-reconfigure gnss2tec-logger." >&2
        fi
    elif [ -f "$CHRONY_CONF" ]; then
        rm -f "$CHRONY_CONF"
        systemctl restart chrony.service 2>/dev/null || systemctl restart chronyd.service 2>/dev/null || true
    fi

    # Enable or disable the hardware watchdog based on runtime.env toggle. This is
    # applied as a systemd manager drop-in (RuntimeWatchdogSec); daemon-reexec is
    # required for the manager to pick it up and open /dev/watchdog.
    WATCHDOG_CONF_DIR="/etc/systemd/system.conf.d"
    WATCHDOG_CONF="${WATCHDOG_CONF_DIR}/gnss2tec-hardware-watchdog.conf"
    if [ "$GNSS2TEC_HARDWARE_WATCHDOG" = "true" ]; then
        WATCHDOG_SECS="${GNSS2TEC_HARDWARE_WATCHDOG_SEC:-30}"
        mkdir -p "$WATCHDOG_CONF_DIR"
        printf '[Manager]\nRuntimeWatchdogSec=%s\n' "$WATCHDOG_SECS" > "$WATCHDOG_CONF"
        systemctl daemon-reexec || true
    elif [ -f "$WATCHDOG_CONF" ]; then
        rm -f "$WATCHDOG_CONF"
        systemctl daemon-reexec || true
    fi

    # Enable or disable the external-HDD backup based on runtime.env toggle.
    # Installs package-managed autofs maps (mount drives on demand at /mnt/<label>)
    # and a daily backup timer. autofs/rsync are Recommends (offline-safe).
    AUTOFS_MASTER_SRC="/usr/share/gnss2tec-logger/autofs/gnss2tec-backup.autofs"
    AUTOFS_MAP_SRC="/usr/share/gnss2tec-logger/autofs/auto.gnss2tec-partlabel"
    AUTOFS_MASTER_DST="/etc/auto.master.d/gnss2tec-backup.autofs"
    AUTOFS_MAP_DST="/etc/auto.gnss2tec-partlabel"
    if [ "$GNSS2TEC_HDD_BACKUP" = "true" ]; then
        if command -v automount >/dev/null 2>&1; then
            # Warn about an old hand-placed map that would duplicate the /mnt mapping.
            if [ -f /etc/auto.master.d/partlabel.autofs ]; then
                echo "gnss2tec-logger: /etc/auto.master.d/partlabel.autofs also maps /mnt; remove it (and /etc/auto.partlabel) to avoid an autofs conflict." >&2
            fi
            install -d -m 0755 /etc/auto.master.d
            install -m 0644 "$AUTOFS_MASTER_SRC" "$AUTOFS_MASTER_DST"
            install -m 0644 "$AUTOFS_MAP_SRC" "$AUTOFS_MAP_DST"
            systemctl reload autofs.service 2>/dev/null || systemctl restart autofs.service 2>/dev/null || true
        else
            echo "gnss2tec-logger: HDD backup requested but autofs is not installed; install autofs (and rsync) then re-run dpkg-reconfigure gnss2tec-logger." >&2
        fi
        if ! command -v rsync >/dev/null 2>&1; then
            echo "gnss2tec-logger: HDD backup requested but rsync is not installed; install rsync for backups to run." >&2
        fi
        systemctl enable gnss2tec-hdd-backup.timer 2>/dev/null || true
        systemctl start gnss2tec-hdd-backup.timer 2>/dev/null || true
    else
        systemctl disable gnss2tec-hdd-backup.timer 2>/dev/null || true
        systemctl stop gnss2tec-hdd-backup.timer 2>/dev/null || true
        if [ -f "$AUTOFS_MASTER_DST" ] || [ -f "$AUTOFS_MAP_DST" ]; then
            rm -f "$AUTOFS_MASTER_DST" "$AUTOFS_MAP_DST"
            systemctl reload autofs.service 2>/dev/null || systemctl restart autofs.service 2>/dev/null || true
        fi
    fi
fi

exit 0
