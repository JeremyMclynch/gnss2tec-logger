# gnss2tec-logger runtime configuration for systemd EnvironmentFile.
# This file is optional and safe to leave as-is.
# Values here override built-in defaults for `gnss2tec-logger run`.

# ArduSimple udev rule: creates /dev/tty_Ardusimple symlink for ArduSimple receivers.
# Set to true to install the udev rule, false to remove it.
# Requires reinstall or running: sudo dpkg-reconfigure gnss2tec-logger
# GNSS2TEC_UDEV_ARDUSIMPLE=false

# USB CDC ACM gadget with serial console (getty):
# Presents the device as a virtual serial port over USB OTG.
# A host connecting via USB sees a CDC ACM device and can open a serial console.
# Set to true to enable the gadget and getty services.
# Requires reinstall or running: sudo dpkg-reconfigure gnss2tec-logger
# GNSS2TEC_USB_GADGET_CONSOLE=false

# Hardware watchdog: lets systemd drive the board's hardware watchdog timer so
# the device reboots itself if the kernel or systemd (PID 1) hangs. This is the
# last-resort recovery for a fully frozen board. Disabled by default; only
# enable it if your hardware exposes a watchdog at /dev/watchdog.
# Set to true to enable, and optionally tune the timeout (seconds).
# Requires reinstall or running: sudo dpkg-reconfigure gnss2tec-logger
# GNSS2TEC_HARDWARE_WATCHDOG=false
# GNSS2TEC_HARDWARE_WATCHDOG_SEC=30

# GPS time sync: discipline the system clock from the receiver's GPS time when
# the device is offline (no network NTP). The logger feeds the parsed UTC time
# into chrony via the NTP shared-memory refclock; chrony does the clock steering.
# Requires the 'chrony' package to be installed (the .deb only Recommends it).
# Set to true to enable; needs a reinstall or: sudo dpkg-reconfigure gnss2tec-logger
# GNSS2TEC_GPS_TIME_SYNC=false

# Serial receiver settings
# Default port is /dev/ttyACM0. If GNSS2TEC_UDEV_ARDUSIMPLE is enabled above,
# set this to /dev/tty_Ardusimple to use the stable symlink instead.
# GNSS2TEC_SERIAL_PORT=/dev/ttyACM0
# GNSS2TEC_BAUD_RATE=115200
# GNSS2TEC_READ_TIMEOUT_MS=250
# GNSS2TEC_READ_BUFFER_BYTES=8192
# GNSS2TEC_COMMAND_GAP_MS=50
# Wait for serial device(s) before launching the logger:
#  - defaults to GNSS2TEC_SERIAL_PORT when set, else /dev/ttyACM*
#  - timeout 0 means wait forever
# GNSS2TEC_SERIAL_WAIT_GLOB=/dev/ttyACM*
# GNSS2TEC_SERIAL_WAIT_TIMEOUT_SECS=0

# Logging and conversion behavior
# GNSS2TEC_FLUSH_INTERVAL_SECS=5
# GNSS2TEC_STATS_INTERVAL_SECS=5
# NMEA monitor interval (seconds) for GSA/GSV/GNS/RMC/GBS/GST status lines.
# Set to 0 to disable NMEA status logs.
# GNSS2TEC_NMEA_LOG_INTERVAL_SECS=30
# NMEA output format: raw | plain | both
# GNSS2TEC_NMEA_LOG_FORMAT=plain
# GNSS2TEC_SHIFT_HOURS=1
# GNSS2TEC_MAX_DAYS_BACK=3
# NAV output format: mixed | individual-tar-gz
# GNSS2TEC_NAV_OUTPUT_FORMAT=individual-tar-gz
# Observation output format: rinex | hatanaka
# GNSS2TEC_OBS_OUTPUT_FORMAT=rinex
# Optional IONEX product from OBS RINEX (true|false).
# GNSS2TEC_OUTPUT_IONEX=false
# Observation sampling interval in seconds (default 1).
# GNSS2TEC_OBS_SAMPLING_SECS=1
# GNSS2TEC_SKIP_NAV=false
# GNSS2TEC_KEEP_UBX=false
# Disk safeguard: when free space on the archive filesystem drops below this many
# MB, the oldest archived day directories are pruned so logging never stops on a
# full disk. Newest products are kept. Set to 0 to disable pruning.
# GNSS2TEC_MIN_FREE_DISK_MB=500

# Paths
# GNSS2TEC_CONFIG_FILE=/etc/gnss2tec-logger/ubx.dat
# GNSS2TEC_DATA_DIR=/var/lib/gnss2tec-logger/data
# GNSS2TEC_ARCHIVE_DIR=/var/lib/gnss2tec-logger/archive
# GNSS2TEC_CONVBIN_PATH=/usr/lib/gnss2tec-logger/bin/convbin
# GNSS2TEC_RNX2CRX_PATH=/usr/lib/gnss2tec-logger/bin/rnx2crx

# Metadata passed to converter (written into RINEX headers).
# STATION is the 4-character station/marker name; COUNTRY is the 3-letter
# ISO code used in the RINEX long filename.
# GNSS2TEC_STATION=STAT
# GNSS2TEC_COUNTRY=XXX
# GNSS2TEC_RECEIVER_TYPE=u-blox ZED-F9P
# GNSS2TEC_ANTENNA_TYPE=Unknown
# GNSS2TEC_OBSERVER=Unknown
